{
  "name": "knowledge-quest",
  "description": "ພະຈົນໄພຄວາມຮູ້ (Knowledge Quest): 2D learning adventure built with Phaser 4, React and TypeScript.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kittisayst/jo-game.git"
  },
  "version": "1.1.0",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "keywords": [
    "phaser",
    "react",
    "vite",
    "typescript",
    "education",
    "game"
  ],
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "build": "node log.js build & vite build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "terser": "^5.28.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vitest": "^4.1.11"
  },
  "bugs": {
    "url": "https://github.com/Kittisayst/jo-game/issues"
  },
  "homepage": "https://github.com/Kittisayst/jo-game#readme"
}
